# Atlas Hub — Docker environment
# Copy to .env:  copy .env.example .env

# --- Local demo (no Snowflake) ---
ATLAS_MOCK_DATA=true
ATLAS_DISABLE_AUTH=true
ATLAS_JWT_SECRET=local-dev-secret-change-me
ATLAS_ENV=dev
ATLAS_ENVIRONMENT=dev

# --- Metrics API ---
METRICS_API_PORT=8080

# --- Snowflake (set ATLAS_MOCK_DATA=false when using real warehouse) ---
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ATLAS_TRANSFORMER
SNOWFLAKE_DATABASE=ANALYTICS_DEV
SNOWFLAKE_WAREHOUSE=WH_ETL_DEV
# Optional key-pair auth for metrics API (mount file to docker/secrets/snowflake_key.p8)
SNOWFLAKE_PRIVATE_KEY_HOST_PATH=./docker/secrets

# --- dbt ---
DBT_TARGET=docker

# --- Airflow (profile: airflow) ---
AIRFLOW_PORT=8081
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_FERNET_KEY=46BKJoQYlPPOavdmXpBHwT7qMhLQZUyqKVTjKvqZJhE=

# --- LocalStack (profile: localstack) ---
LOCALSTACK_DEBUG=0
